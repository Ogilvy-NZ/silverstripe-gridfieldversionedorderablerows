{
	"name": "toastnz/silverstripe-gridfieldversionedorderablerows",
	"description": "Allows Versioned Orderable Rows In GridField",
	"type": "silverstripe-vendormodule",
	"license": "MIT",
	"authors": [
		{
			"name": "Cam Spiers",
			"email": "camspiers@gmail.com"
		}
	],
	"require": {
		"silverstripe/framework": "^5.4",
		"silverstripe/vendor-plugin": "^2.1",
		"symbiote/silverstripe-gridfieldextensions": "^4.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"Heyday\\GridFieldVersionedOrderableRows\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"silverstripe/vendor-plugin": true
		}
	}
}
